

# --- WinkPay ---
WINKPAY_BASE_URL=https://panel.winkpay.digital
WINKPAY_API_TOKEN=REPLACE_WITH_REAL
WINKPAY_MERCHANT_ID=REPLACE_WITH_REAL
WINKPAY_CALLBACK_URL=https://your-domain.example/winkpay/callback
WINKPAY_SUCCESS_URL=https://your-domain.example/pay/success
WINKPAY_FAIL_URL=https://your-domain.example/pay/fail
WINKPAY_MAX_WAIT_MS=30000

# --- 3x-ui subscription links ---
# True: VLESS/Shadowsocks users receive a 3x-ui subscription URL instead of a single config URI.
XUI_USE_SUBSCRIPTION_LINK=True
# Must match "Subscription" settings in the 3x-ui panel.
XUI_SUBSCRIPTION_PORT=2096
XUI_SUBSCRIPTION_PATH=/sub/
# Optional. Use when 3x-ui subscriptions are published on a domain, not on the panel IP.
XUI_SUBSCRIPTION_HOST=
# Leave empty to use the same scheme as the panel connection, or set http/https explicitly.
XUI_SUBSCRIPTION_SCHEME=
